{
  "name": "currito",
  "version": "0.1.0",
  "description": "Currito — editor de currículums compatibles con ATS, 100% client-side (React + Vite + TypeScript).",
  "license": "MIT",
  "author": "Martino Costigliolo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Martino17x/currito.git"
  },
  "bugs": {
    "url": "https://github.com/Martino17x/currito/issues"
  },
  "homepage": "https://github.com/Martino17x/currito#readme",
  "keywords": [
    "cv",
    "resume",
    "curriculum",
    "ats",
    "ats-friendly",
    "vite",
    "react",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "smoke": "vite build --ssr scripts/smoke.ts --outDir dist-ssr && node dist-ssr/smoke.js",
    "check": "pnpm typecheck && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.5.0",
    "vite": "^8.0.0"
  }
}
