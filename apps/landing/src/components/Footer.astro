---
import { REPO_URL } from '../config';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <a class="logo logo--footer" href="/" aria-label="Currito — inicio">
        <span class="logo__mark">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M6 7h12M6 12h12M6 17h8" />
          </svg>
        </span>
        Currito
      </a>
      <p class="site-footer__tagline">Editor de CV compatibles con ATS · Open source · Hecho con ♥ en Argentina</p>
    </div>
    <ul class="site-footer__links">
      <li><a href="/plantillas">Plantillas</a></li>
      <li><a href="/precios">Precios</a></li>
      <li><a href={REPO_URL} target="_blank" rel="noopener">GitHub</a></li>
    </ul>
  </div>
</footer>
