---
import { APP_URL } from '../config';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/plantillas', label: 'Plantillas' },
  { href: '/precios', label: 'Precios' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="/" aria-label="Currito — inicio">
      <span class="logo__mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M6 7h12M6 12h12M6 17h8" />
        </svg>
      </span>
      Currito
    </a>

    <nav class="site-nav" data-nav aria-label="Navegación principal">
      <ul class="site-nav__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class:list={{ 'is-active': path === link.href }}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__cta">
        <a class="btn btn--ghost" href="/precios">Ver precios</a>
        <a class="btn btn--primary" href={APP_URL} target="_blank" rel="noopener">Crear mi CV</a>
      </div>
    </nav>

    <button class="nav-toggle" data-nav-toggle aria-label="Abrir menú" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>
</header>

