---
import { APP_URL } from '../config';
---

<section class="section">
  <div class="container">
    <div class="cta-band reveal">
      <span class="eyebrow" style="background:rgba(255,255,255,0.12); border-color:rgba(255,255,255,0.2); color:#fff;">
        Gratis para siempre
      </span>
      <h2>Tu próximo CV arranca acá.</h2>
      <p>Creá, editá y exportá tu currículum en minutos. Sin registro y sin subir tus datos a ningún lado.</p>
      <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
        <a class="btn btn--light" href={APP_URL} target="_blank" rel="noopener">Crear mi CV gratis</a>
        <a class="btn btn--outline-light" href="/precios">Ver precios</a>
      </div>
    </div>
  </div>
</section>

