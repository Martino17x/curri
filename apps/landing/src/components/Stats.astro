---
const stats = [
  { num: '0', label: 'servidores' },
  { num: '100 %', label: 'client-side' },
  { num: '5+', label: 'plantillas' },
  { num: '1 clic', label: 'a PDF' },
];
---

<section class="section" style="padding-block: 24px;">
  <div class="container">
    <div class="stats">
      {
        stats.map((s) => (
          <div class="stats__item reveal">
            <p class="stats__num">{s.num}</p>
            <p class="stats__label">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

